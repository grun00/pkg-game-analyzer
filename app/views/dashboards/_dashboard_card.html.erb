<% total  = dashboard.matches.count
   wins   = dashboard.matches.wins.count
   rate   = total.zero? ? 0.0 : (wins.to_f / total * 100).round(1) %>

<div class="db-card">
  <div class="db-card-hd">
    <span class="db-card-name cursor"><%= dashboard.name %></span>
    <div class="db-card-acts">
      <%= link_to "EDIT", edit_dashboard_path(dashboard), class: "btn-ghost c-dim" %>
      <%= button_to "DEL", dashboard_path(dashboard), method: :delete,
            data: { turbo_confirm: "Delete '#{dashboard.name}'? This will remove all its matches." },
            form: { style: "display:inline;" },
            class: "btn-ghost c-red" %>
    </div>
  </div>

  <div class="db-card-stats">
    <span><span class="c-green fw"><%= total %></span> matches</span>
    <span><span class="c-green fw"><%= wins %></span>W</span>
    <span><span class="c-gold fw"><%= rate %>%</span></span>
  </div>

  <%= link_to "[ ACCESS DASHBOARD ]", dashboard_path(dashboard), class: "db-card-link" %>
</div>
