<%= form_with model: dashboard, html: { class: "term-form" } do |f| %>
  <% if dashboard.errors.any? %>
    <div class="form-errors">
      <strong><%= pluralize(dashboard.errors.count, "error") %>:</strong>
      <ul>
        <% dashboard.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grp">
    <%= f.label :name, "Dashboard Name", class: "form-lbl" %>
    <%= f.text_field :name, placeholder: "e.g. Regional 2025, Ranked Ladder…", class: "form-ctrl" %>
  </div>

  <%= f.submit "[ SAVE ]", class: "form-submit" %>
<% end %>
