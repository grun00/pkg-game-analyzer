<% content_for :title, "My Dashboards – TRAINER_OS" %>

<div class="page-hd">
  <div>
    <h1 class="page-title cursor">My Dashboards</h1>
    <p class="page-sub">each dashboard tracks its own set of matches</p>
  </div>
  <%= link_to "+ NEW DASHBOARD", new_dashboard_path, class: "btn btn-g" %>
</div>

<% if @dashboards.empty? %>
  <div class="empty">
    <p>No dashboards found.</p>
    <%= link_to "[ INITIALIZE FIRST DASHBOARD ]", new_dashboard_path, class: "btn btn-g" %>
  </div>
<% else %>
  <div class="db-grid">
    <% @dashboards.each do |dashboard| %>
      <%= render "dashboards/dashboard_card", dashboard: dashboard %>
    <% end %>
  </div>
<% end %>
