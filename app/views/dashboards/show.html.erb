<% content_for :title, "#{@dashboard.name} – TRAINER_OS" %>

<div class="page-hd">
  <div>
    <p class="breadcrumb"><%= link_to "← ALL DASHBOARDS", dashboards_path %></p>
    <h1 class="page-title cursor"><%= @dashboard.name %></h1>
  </div>
  <div style="display:flex;gap:10px;">
    <%= link_to "ALL MATCHES", dashboard_matches_path(@dashboard), class: "btn btn-b btn-sm" %>
    <%= link_to "+ LOG MATCH", new_dashboard_match_path(@dashboard), class: "btn btn-g btn-sm" %>
  </div>
</div>

<% if @stats[:total].zero? %>
  <div class="empty">
    <p>No battle data found.</p>
    <%= link_to "[ LOG FIRST MATCH ]", new_dashboard_match_path(@dashboard), class: "btn btn-g" %>
  </div>
<% else %>

  <%# ── Summary cards ── %>
  <p class="sec-lbl">System Status</p>
  <div class="stat-grid">
    <%= render "dashboards/stat_card", label: "Total Matches", value: @stats[:total], css_class: "c-green" %>
    <%= render "dashboards/stat_card", label: "Wins",          value: @stats[:wins],  css_class: "c-green" %>
    <%= render "dashboards/stat_card", label: "Losses",        value: @stats[:losses], css_class: "c-red" %>
    <%= render "dashboards/stat_card", label: "Win Rate",      value: "#{@stats[:win_rate]}%", css_class: "c-gold" %>
    <%= render "dashboards/stat_card", label: "Avg Hand ★",    value: @stats[:average_hand_quality], css_class: "c-blue" %>
  </div>

  <%# ── By deck ── %>
  <p class="sec-lbl">Results by Opponent Deck</p>
  <div style="overflow-x:auto;margin-bottom:32px;">
    <table class="term-table">
      <thead>
        <tr>
          <th>Deck</th>
          <th class="tc">Total</th>
          <th class="tc c-green">W</th>
          <th class="tc c-red">L</th>
          <th class="tc c-gold">Win%</th>
          <th class="tc c-blue">1st%</th>
          <th class="tc c-pink">2nd%</th>
          <th class="tc">Bar</th>
        </tr>
      </thead>
      <tbody>
        <% @stats[:by_deck].each do |row| %>
          <tr>
            <td class="c-green fw"><%= row[:label] %></td>
            <td class="tc"><%= row[:total] %></td>
            <td class="tc c-green"><%= row[:wins] %></td>
            <td class="tc c-red"><%= row[:losses] %></td>
            <td class="tc c-gold"><%= row[:win_rate] %>%</td>
            <% [:first, :second].each do |side| %>
              <% data = row[side] %>
              <td class="tc">
                <% if data[:win_rate].nil? %>
                  <span class="c-mute">—</span>
                <% else %>
                  <span class="<%= side == :first ? 'c-blue' : 'c-pink' %> fw"><%= data[:win_rate] %>%</span>
                  <span class="c-dim" style="display:block;font-size:.65rem;"><%= data[:wins] %>W–<%= data[:losses] %>L</span>
                <% end %>
              </td>
            <% end %>
            <td>
              <div class="bar"><div class="bar-fill" style="width:<%= row[:win_rate] %>%;"></div></div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# ── By hand quality ── %>
  <p class="sec-lbl">Win Rate by Initial Hand Quality</p>
  <div class="hq-grid">
    <% @stats[:by_hand_quality].each do |row| %>
      <div class="hq-card">
        <div class="hq-stars"><%= "★" * row[:quality] %><%= "☆" * (5 - row[:quality]) %></div>
        <div class="hq-rate"><%= row[:win_rate] %>%</div>
        <div class="hq-count"><%= row[:total] %> games</div>
      </div>
    <% end %>
  </div>

  <%# ── First vs Second ── %>
  <% informed_total = @stats[:by_first_or_second].sum { |r| r[:total] } %>
  <% if informed_total > 0 %>
    <p class="sec-lbl">Going First vs Second</p>
    <div class="side-grid">
      <% @stats[:by_first_or_second].each do |row| %>
        <div class="side-card <%= row[:side] == :first ? 'side-card-1' : 'side-card-2' %>">
          <div class="side-lbl <%= row[:side] == :first ? 'c-blue' : 'c-pink' %>">Going <%= row[:side].upcase %></div>
          <div class="side-rate"><%= row[:win_rate] %>%</div>
          <div class="side-rec"><%= row[:wins] %>W – <%= row[:losses] %>L (<%= row[:total] %> games)</div>
        </div>
      <% end %>
      <% uninformed = @stats[:total] - informed_total %>
      <% if uninformed > 0 %>
        <div class="side-card side-card-n">
          <div class="side-lbl">Not Informed</div>
          <div class="side-rate c-dim"><%= uninformed %></div>
          <div class="side-rec">games without data</div>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# ── Reasons for defeat ── %>
  <% if @stats[:losses] > 0 %>
    <p class="sec-lbl">Reasons for Defeat</p>
    <div class="hq-grid">
      <% @stats[:by_defeat_reason][:reasons].each do |row| %>
        <% next if row[:count].zero? %>
        <div class="hq-card">
          <div class="hq-stars c-red" style="font-size:.7rem;letter-spacing:1px;"><%= row[:label].upcase %></div>
          <div class="hq-rate c-red"><%= row[:count] %></div>
          <div class="hq-count"><%= "loss".pluralize(row[:count]) %></div>
        </div>
      <% end %>
      <% if @stats[:by_defeat_reason][:unspecified] > 0 %>
        <div class="hq-card" style="opacity:.5;">
          <div class="hq-stars c-dim" style="font-size:.7rem;letter-spacing:1px;">NOT SPECIFIED</div>
          <div class="hq-rate c-dim"><%= @stats[:by_defeat_reason][:unspecified] %></div>
          <div class="hq-count"><%= "loss".pluralize(@stats[:by_defeat_reason][:unspecified]) %></div>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# ── Recent matches ── %>
  <div class="page-hd" style="margin-bottom:12px;">
    <p class="sec-lbl" style="margin:0;">Recent Battles</p>
    <%= link_to "VIEW ALL →", dashboard_matches_path(@dashboard), class: "btn-ghost c-dim" %>
  </div>
  <div class="match-log">
    <% @stats[:recent_matches].each do |match| %>
      <%= render "dashboards/recent_match_row", match: match, dashboard: @dashboard %>
    <% end %>
  </div>

<% end %>
