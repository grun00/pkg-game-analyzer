<div class="auth-wrap">
  <div class="auth-box">
    <div class="auth-bar">TRAINER_OS // NEW TRAINER REGISTRATION</div>
    <div class="auth-body">
      <h1 class="auth-title c-green cursor">CREATE ACCOUNT</h1>

      <%= render "devise/shared/error_messages", resource: resource %>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "term-form" }) do |f| %>
        <div class="form-grp">
          <%= f.label :email, "Trainer ID (email)", class: "form-lbl" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-ctrl" %>
        </div>

        <div class="form-grp">
          <%= f.label :password, "Access Code (password)", class: "form-lbl" %>
          <% if @minimum_password_length %>
            <p class="c-mute" style="font-size:.72rem;margin-bottom:4px;">minimum <%= @minimum_password_length %> characters</p>
          <% end %>
          <%= f.password_field :password, autocomplete: "new-password", class: "form-ctrl" %>
        </div>

        <div class="form-grp">
          <%= f.label :password_confirmation, "Confirm Access Code", class: "form-lbl" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-ctrl" %>
        </div>

        <%= f.submit "[ INITIALIZE TRAINER ]", class: "form-submit" %>
      <% end %>

      <div class="auth-links">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
