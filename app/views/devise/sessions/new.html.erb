<div class="auth-wrap">
  <div class="auth-box">
    <div class="auth-bar">TRAINER_OS // AUTHENTICATION REQUIRED</div>
    <div class="auth-body">
      <h1 class="auth-title c-green cursor">ACCESS TERMINAL</h1>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "term-form" }) do |f| %>
        <div class="form-grp">
          <%= f.label :email, "Trainer ID (email)", class: "form-lbl" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-ctrl" %>
        </div>

        <div class="form-grp">
          <%= f.label :password, "Access Code (password)", class: "form-lbl" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "form-ctrl" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="form-radio c-dim">
            <%= f.check_box :remember_me %> <%= f.label :remember_me, "Keep session active" %>
          </div>
        <% end %>

        <%= f.submit "[ AUTHENTICATE ]", class: "form-submit" %>
      <% end %>

      <div class="auth-links">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
