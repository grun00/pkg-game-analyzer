<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Pkm Game Analyzer" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav style="background:#1a1a2e;padding:12px 24px;display:flex;align-items:center;justify-content:space-between;">
      <a href="<%= root_path %>" style="color:#e94560;font-weight:bold;font-size:1.2rem;text-decoration:none;">⚡ PKM Analyzer</a>
      <div style="display:flex;gap:16px;align-items:center;">
        <% if user_signed_in? %>
          <%= link_to "My Dashboards", dashboards_path, style: "color:#ccc;text-decoration:none;" %>
          <span style="color:#888;font-size:0.85rem;"><%= current_user.email %></span>
          <%= button_to "Sign Out", destroy_user_session_path, method: :delete, style: "background:transparent;border:1px solid #555;color:#ccc;padding:5px 12px;border-radius:6px;cursor:pointer;" %>
        <% else %>
          <%= link_to "Sign In", new_user_session_path, style: "color:#ccc;text-decoration:none;" %>
          <%= link_to "Sign Up", new_user_registration_path, style: "background:#e94560;color:#fff;padding:6px 14px;border-radius:6px;text-decoration:none;" %>
        <% end %>
      </div>
    </nav>

    <% if notice.present? %>
      <div style="background:#1e3a1e;color:#6fcf97;padding:10px 24px;border-left:4px solid #6fcf97;"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div style="background:#3a1e1e;color:#eb5757;padding:10px 24px;border-left:4px solid #eb5757;"><%= alert %></div>
    <% end %>

    <main style="max-width:1100px;margin:0 auto;padding:24px 16px;">
      <%= yield %>
    </main>
  </body>
</html>
