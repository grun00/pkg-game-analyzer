<%= form_with model: [@dashboard, match], html: { class: "term-form" } do |f| %>
  <% if match.errors.any? %>
    <div class="form-errors">
      <strong><%= pluralize(match.errors.count, "error") %> prevented this match from being saved:</strong>
      <ul>
        <% match.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grp">
    <%= f.label :opponent_deck, "Opponent Deck", class: "form-lbl" %>
    <%= f.select :opponent_deck,
          Match::OPPONENT_DECKS.keys.map { |d| [d.to_s.humanize, d] }.sort_by { |label, _| label },
          { prompt: "Select a deck…" },
          class: "form-ctrl select" %>
  </div>

  <div class="form-grp">
    <%= f.label :result, "Result", class: "form-lbl" %>
    <div class="form-radios">
      <label class="form-radio c-green">
        <%= f.radio_button :result, "win",  id: "match_result_win",  style: "accent-color:var(--green);" %> WIN
      </label>
      <label class="form-radio c-red">
        <%= f.radio_button :result, "loss", id: "match_result_loss", style: "accent-color:var(--red);" %> LOSS
      </label>
      <label class="form-radio c-blue">
        <%= f.radio_button :result, "tie", id: "match_result_tie", style: "accent-color:var(--blue);" %> TIE
      </label>
    </div>
  </div>

  <div class="form-grp" id="defeat-reason-group" style="display:none;">
    <%= f.label :reason_for_defeat, "Reason for Defeat", class: "form-lbl" %>
    <div class="form-radios">
      <% Match::DEFEAT_REASONS.keys.each do |reason| %>
        <label class="form-radio c-red">
          <%= f.radio_button :reason_for_defeat, reason, style: "accent-color:var(--red);" %>
          <%= reason.to_s.humanize %>
        </label>
      <% end %>
    </div>
  </div>

  <div class="form-grp">
    <%= f.label :first_or_second, "Going First or Second (optional)", class: "form-lbl" %>
    <div class="form-radios">
      <label class="form-radio c-dim">
        <%= f.radio_button :first_or_second, "uninformed", style: "accent-color:var(--gmid);" %> N/A
      </label>
      <label class="form-radio c-blue">
        <%= f.radio_button :first_or_second, "first", style: "accent-color:var(--blue);" %> 1ST
      </label>
      <label class="form-radio c-pink">
        <%= f.radio_button :first_or_second, "second", style: "accent-color:var(--pink);" %> 2ND
      </label>
    </div>
  </div>

  <div class="form-grp">
    <%= f.label :number_of_mulligans, "Number of Mulligans (optional)", class: "form-lbl" %>
    <%= f.number_field :number_of_mulligans, min: 0, step: 1,
          placeholder: "0",
          class: "form-ctrl", style: "max-width:120px;" %>
  </div>

  <div class="form-grp">
    <%= f.label :hand_quality, "Initial Hand Quality (1=terrible / 5=perfect)", class: "form-lbl" %>
    <%= f.select :hand_quality,
          (1..5).map { |n| ["#{n} #{"★" * n}", n] },
          { prompt: "Rate your hand…" },
          class: "form-ctrl select" %>
  </div>

  <div class="form-grp">
    <%= f.label :description, "Game Notes (optional)", class: "form-lbl" %>
    <%= f.text_area :description, rows: 4,
          placeholder: "Describe how the game went…",
          class: "form-ctrl", style: "resize:vertical;" %>
  </div>

  <div class="form-grp">
    <%= f.label :played_at, "Date Played", class: "form-lbl" %>
    <%= f.datetime_local_field :played_at,
          value: match.played_at&.strftime("%Y-%m-%dT%H:%M"),
          class: "form-ctrl" %>
  </div>

  <%= f.submit "[ SUBMIT ]", class: "form-submit" %>
<% end %>

<script>
  (function () {
    var group  = document.getElementById('defeat-reason-group');
    var radios = document.querySelectorAll('input[name="match[result]"]');
    function sync() {
      var checked = document.querySelector('input[name="match[result]"]:checked');
      group.style.display = (checked && checked.value === 'loss') ? 'flex' : 'none';
    }
    radios.forEach(function(r) { r.addEventListener('change', sync); });
    sync();
  })();
</script>
