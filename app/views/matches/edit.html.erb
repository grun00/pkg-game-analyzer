<% content_for :title, "Edit Match – TRAINER_OS" %>

<div class="page-hd">
  <div>
    <p class="breadcrumb"><%= link_to "← All Matches", dashboard_matches_path(@dashboard) %></p>
    <h1 class="page-title">Edit Match</h1>
    <p class="page-sub">update the details of this battle</p>
  </div>
</div>

<%= render "form", match: @match, dashboard: @dashboard %>

<div style="margin-top:24px;display:flex;gap:24px;align-items:center;">
  <%= link_to "← BACK TO MATCHES", dashboard_matches_path(@dashboard), class: "btn-ghost c-dim" %>
  <%= button_to "[ DELETE MATCH ]", dashboard_match_path(@dashboard, @match), method: :delete,
        data: { turbo_confirm: "Permanently delete this match record?" },
        form: { style: "display:inline;" },
        class: "btn-ghost c-red" %>
</div>
