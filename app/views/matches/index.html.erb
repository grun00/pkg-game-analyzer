<% content_for :title, "All Matches – PKM Analyzer" %>

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;">
  <h1 style="color:#e94560;margin:0;">All Matches</h1>
  <%= link_to "+ Register Match", new_match_path, style: "background:#e94560;color:#fff;padding:8px 18px;border-radius:8px;text-decoration:none;font-weight:bold;" %>
</div>

<% if @matches.empty? %>
  <div style="text-align:center;padding:60px 0;color:#666;">
    <p>No matches yet. <%= link_to "Register one!", new_match_path, style: "color:#e94560;" %></p>
  </div>
<% else %>
  <div style="display:flex;flex-direction:column;gap:10px;">
    <% @matches.each do |match| %>
      <div style="background:#16213e;border-radius:8px;padding:14px 18px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
        <span style="font-size:1.2rem;"><%= match.result_win? ? "✅" : "❌" %></span>
        <span style="color:#ddd;font-weight:bold;flex:1;min-width:140px;"><%= match.opponent_deck.to_s.humanize %></span>
        <span style="color:#aaa;font-size:0.85rem;">Hand: <%= "★" * match.hand_quality %><%= "☆" * (5 - match.hand_quality) %></span>
        <span style="color:#888;font-size:0.85rem;flex:2;"><%= truncate(match.description, length: 60) if match.description.present? %></span>
        <span style="color:#555;font-size:0.8rem;"><%= match.played_at.strftime("%b %d, %Y") %></span>
        <div style="display:flex;gap:10px;">
          <%= link_to "View", match_path(match), style: "color:#aaa;font-size:0.85rem;" %>
          <%= link_to "Edit", edit_match_path(match), style: "color:#e94560;font-size:0.85rem;" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
