<% content_for :title, "All Matches – TRAINER_OS" %>

<div class="page-hd">
  <div>
    <p class="breadcrumb"><%= link_to "← #{@dashboard.name}", dashboard_path(@dashboard) %></p>
    <h1 class="page-title">Match Log</h1>
  </div>
  <%= link_to "+ LOG MATCH", new_dashboard_match_path(@dashboard), class: "btn btn-g" %>
</div>

<% if @matches.empty? %>
  <div class="empty">
    <p>No battle records found.</p>
    <%= link_to "[ LOG FIRST MATCH ]", new_dashboard_match_path(@dashboard), class: "btn btn-g" %>
  </div>
<% else %>
  <div class="match-log">
    <% @matches.each do |match| %>
      <div class="match-row <%= match_result_row_class(match) %>">
        <span class="match-ind <%= match_result_color_class(match) %>"><%= match_result_label(match) %></span>
        <span class="match-deck"><%= match.opponent_deck.to_s.humanize %></span>
        <span class="match-hand"><%= "★" * match.hand_quality %><%= "☆" * (5 - match.hand_quality) %></span>
        <span class="match-note"><%= truncate(match.description, length: 55) if match.description.present? %></span>
        <span class="match-date"><%= match.played_at.strftime("%b %d, %Y") %></span>
        <div style="display:flex;gap:12px;">
          <%= link_to "VIEW", dashboard_match_path(@dashboard, match), class: "btn-ghost c-dim btn-sm" %>
          <%= link_to "EDIT", edit_dashboard_match_path(@dashboard, match), class: "btn-ghost c-green btn-sm" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
