<% content_for :title, "Match – TRAINER_OS" %>

<div class="page-hd">
  <div>
    <p class="breadcrumb"><%= link_to "← Match Log", dashboard_matches_path(@dashboard) %></p>
    <h1 class="page-title <%= match_result_color_class(@match) %>"><%= @match.opponent_deck.to_s.humanize %></h1>
    <p class="page-sub"><%= @match.played_at.strftime("%B %d, %Y – %H:%M") %></p>
  </div>
  <%= link_to "EDIT", edit_dashboard_match_path(@dashboard, @match), class: "btn btn-g btn-sm" %>
</div>

<div class="match-detail">
  <div>
    <div class="detail-lbl">Result</div>
    <div class="detail-val <%= match_result_color_class(@match) %>"><%= @match.result.upcase %></div>
  </div>

  <% unless @match.first_or_second_uninformed? %>
    <div>
      <div class="detail-lbl">Going</div>
      <div class="detail-val <%= @match.first_or_second_first? ? 'c-blue' : 'c-pink' %>">
        <%= @match.first_or_second.upcase %>
      </div>
    </div>
  <% end %>

  <div>
    <div class="detail-lbl">Initial Hand Quality</div>
    <div class="detail-val c-gold">
      <%= "★" * @match.hand_quality %><%= "☆" * (5 - @match.hand_quality) %>
      <span class="c-dim" style="font-size:.9rem;">(<%= @match.hand_quality %>/5)</span>
    </div>
  </div>

  <% if @match.number_of_mulligans.present? %>
    <div>
      <div class="detail-lbl">Mulligans</div>
      <div class="detail-val c-gold"><%= @match.number_of_mulligans %></div>
    </div>
  <% end %>

  <% if @match.result_loss? && @match.reason_for_defeat.present? %>
    <div>
      <div class="detail-lbl">Reason for Defeat</div>
      <div class="detail-val c-red"><%= @match.reason_for_defeat.to_s.humanize.upcase %></div>
    </div>
  <% end %>

  <% if @match.description.present? %>
    <div>
      <div class="detail-lbl">Game Notes</div>
      <p style="color:var(--green);line-height:1.7;font-size:.85rem;"><%= @match.description %></p>
    </div>
  <% end %>
</div>

<div style="margin-top:20px;display:flex;gap:20px;">
  <%= link_to "← ALL MATCHES", dashboard_matches_path(@dashboard), class: "btn-ghost c-dim" %>
</div>
